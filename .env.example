# ── Flask ─────────────────────────────────────────────────────────────
# Genera una clave con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
HOST=127.0.0.1
PORT=5000
# 1 = recarga automática al editar (desarrollo); 0 = ejecución estable (uso normal)
FLASK_DEBUG=0

# ── Base de datos ─────────────────────────────────────────────────────
# Por defecto se usa SQLite en instance/tendry.db.
# DATABASE_URL=sqlite:///C:/ruta/absoluta/instance/tendry.db

# ── Valores iniciales (luego se editan en la web) ─────────────────────
# URLs separadas por comas o saltos de línea. Formato: Etiqueta | URL
DEFAULT_URLS=
DEFAULT_KEYWORDS=calendario de adviento, advent calendar, adviento
CHECK_INTERVAL_MINUTES=15
# Tienda que se muestra incrustada al final del panel (opcional).
STORE_URL=

# ── Rastreo ───────────────────────────────────────────────────────────
REQUEST_TIMEOUT=20
REQUEST_DELAY_SECONDS=2
MAX_PRODUCT_PAGES=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# ── ntfy.sh (recomendado para iPhone) ─────────────────────────────────
NTFY_SERVER=https://ntfy.sh
# Elige un tema difícil de adivinar y suscríbete a él en la app ntfy.
NTFY_TOPIC=
NOTIFY_CHANNEL=ntfy

# ── Correo SMTP (opcional) ────────────────────────────────────────────
EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# En Gmail usa una contraseña de aplicación, no tu contraseña normal.
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# ── WhatsApp (opcional) ───────────────────────────────────────────────
# Elige "twilio" o "callmebot". Si lo dejas vacío, se detecta solo.
WHATSAPP_PROVIDER=
# Número de destino por defecto (también se puede editar en la web).
WHATSAPP_TO=

# Opción A: Twilio (oficial). Activa el Sandbox de WhatsApp en Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del sandbox o número propio, con prefijo: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Opción B: CallMeBot (gratuito, uso personal, API no oficial).
# Pide tu apikey al bot de CallMeBot desde tu WhatsApp.
CALLMEBOT_APIKEY=

# ── Telegram (opcional) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Scheduler ─────────────────────────────────────────────────────────
SCHEDULER_ENABLED=1
